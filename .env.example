# Copy to .env for local runs (never commit real secrets; .env is gitignored).
# Register once: python -m roombrain register --server URL --token KEY --name roombrain
SWITCH_SERVER_URL=http://127.0.0.1:8000
ROOMBRAIN_AGENT_ID=
ROOMBRAIN_API_KEY=
AGENT_REGISTRATION_TOKEN=
OPENROUTER_API_KEY=
# OpenRouter model slug for llm() (default: openai/gpt-4o-mini).
LLM_MODEL=
# Auto-created on first `python -m roombrain run` (stable reconnect identity).
ROOMBRAIN_CONNECTION_ID=
# Comma-separated room ids to attach to the WebSocket connection.
ROOMBRAIN_ROOMS=
GMAIL_OAUTH_TOKEN=
LINEAR_API_KEY=
# Optional Linear team id passed as teamId on issueCreate.
#LINEAR_TEAM_ID=
# Stub-ability overrides (production defaults in comments).
#GMAIL_API_BASE_URL=https://gmail.googleapis.com
#LINEAR_API_URL=https://api.linear.app/graphql
